{
  "name": "cmux-gallery-root-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cm6": "node --experimental-strip-types scripts/build-cm6.mts",
    "typecheck:studio": "tsc -p tsconfig.json",
    "test": "python3 -m unittest discover -s tests -p test_reapply_edits.py -v && node --test tests/unit/*.test.mts && npm run test:e2e",
    "test:e2e": "playwright test",
    "prebuild:cm6": "node --experimental-strip-types ../scripts/build-browser-sources.mts",
    "pretest:e2e": "npm run build:cm6 && npm --prefix .. run build:gallery-editors",
    "pretest:unit": "npm run build:cm6",
    "pretest": "npm run build:cm6",
    "test:unit": "node --test tests/unit/*.test.mts"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.61.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@codemirror/lint": "^6.9.7",
    "@overleaf/lezer-latex": "^0.1.0",
    "@uiw/codemirror-theme-dracula": "^4.25.11",
    "@uiw/codemirror-theme-gruvbox-dark": "^4.25.11",
    "@uiw/codemirror-theme-material": "^4.25.11",
    "@uiw/codemirror-theme-monokai": "^4.25.11",
    "@uiw/codemirror-theme-nord": "^4.25.11",
    "@uiw/codemirror-theme-solarized": "^4.25.11",
    "@uiw/codemirror-theme-vscode": "^4.25.11"
  }
}
